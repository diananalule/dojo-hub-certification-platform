{
  "name": "dojo-hub-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "build": "npm run build:api && npm run build:web",
    "lint:api": "npm run lint --workspace=api",
    "lint:web": "npm run lint --workspace=web",
    "test:api": "npm run test --workspace=api",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "prisma:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "db:up": "docker compose up -d postgres redis minio",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
